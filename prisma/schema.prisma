// Prisma schema za slovensko restavracijsko blagajno (POS)
// Multi-tenant SaaS — več restavracij v eni instalaciji
// Navdihnjeno po ICEPOS arhitekturi, prilagojeno za slovenski trg (EUR, DDV, FURS)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================================
// RESTAURANT (TENANT) — centralni model za multi-tenant
// ============================================================

model Restaurant {
  id              String   @id @default(cuid())
  name            String   // "Gostilna Pri Marku"
  slug            String   @unique // URL slug: "gostilna-pri-marku"
  subdomain       String?  @unique // "marko" → marko.pos.si
  address         String?
  city            String?
  phone           String?
  email           String?
  website         String?

  // FURS podatki (per restavracija)
  taxNumber       String   @default("SI12345678") // davčna št.
  businessUnit    String   @default("PREVOZ11") // oznaka poslovnega prostora
  cashRegister    String   @default("BLAG01") // oznaka blagajne
  fursEnv         String   @default("test") // "test" | "production"
  fursCertPath    String?  // pot do eDavki certifikata
  fursCertPassword String?

  // Nastavitve
  currency        String   @default("EUR")
  timezone        String   @default("Europe/Ljubljana")
  language        String   @default("sl")
  loyaltyRate     Float    @default(0.1) // 1 točka na 10 EUR (0.1)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relacije (vse entitete pripadajo restavraciji)
  menuItems       MenuItem[]
  tables          Table[]
  orders          Order[]
  reservations    Reservation[]
  shifts          Shift[]
  operators       Operator[]
  inventoryItems  InventoryItem[]
  customers       Customer[]
  giftCards       GiftCard[]
  wasteLogs       WasteLog[]
  happyHours      HappyHour[]
  comboMeals      ComboMeal[]
  feedbacks       Feedback[]
  waitlist        WaitlistEntry[]
  suppliers       Supplier[]
  cashDrawer      CashDrawerEntry[]
  purchaseOrders  PurchaseOrder[]
  equipment       Equipment[]
  stockTransfers  StockTransfer[]
}

// ============================================================
// MENU
// ============================================================

model MenuItem {
  id            String   @id @default(cuid())
  restaurantId  String
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name          String
  nameEn        String?
  category      String // "predjedi" | "glavne_jedi" | "brezalkoholne" | "alkoholne" | "sladice"
  price         Float // EUR
  vatRate       Float // 0.095 (znižana - hrana) | 0.22 (splošna - alkohol)
  available     Boolean @default(true)
  desc          String?
  descEn        String?
  allergens     String? // JSON array alergenov
  calories      Int?
  protein       Float?
  carbs         Float?
  fat           Float?
  isFavorite    Boolean @default(false)
  isDailySpecial Boolean @default(false)
  imageUrl      String?  // AI-generirana slika jedi
  createdAt     DateTime @default(now())
  orderItems    OrderItem[]
  modifiers     Modifier[]
  recipes       Recipe[]
}

model Modifier {
  id         String   @id @default(cuid())
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  label      String // npr. "Brez čebule", "Dobra pečena", "Bez glutena"
  priceDelta Float    @default(0) // sprememba cene (Lahko negativna za popust)
  createdAt  DateTime @default(now())
}

// ============================================================
// TABLES & ORDERS
// ============================================================

model Table {
  id           String   @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  number       Int
  name         String
  seats        Int      @default(4)
  section      String   @default("Dvorana") // "Dvorana" | "Terasa" | "Zasebna"
  createdAt    DateTime @default(now())
  orders       Order[]
  reservations Reservation[]

  @@unique([restaurantId, number])
}

model Order {
  id            String    @id @default(cuid())
  restaurantId  String
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  tableId       String
  table         Table     @relation(fields: [tableId], references: [id])
  status        String    @default("open") // "open" | "paid" | "cancelled" | "storno"
  items         OrderItem[]
  total         Float     @default(0)
  vatTotal      Float     @default(0)
  createdAt     DateTime  @default(now())
  paidAt        DateTime?
  paymentMethod String? // "cash" | "card" | "giftcard"
  receiptNo     String? // SRS številka računa
  zoi           String? // Zaščitna oznaka izdajatelja (ZOI) — 32 hex
  eor           String? // Enkratna identifikacija računa (EOR) — UUID
  fursXml       String? // Podpisan XML računa za FURS (audit)
  businessUnit  String   @default("PREVOZ11")
  cashRegister  String   @default("BLAG01")
  invoiceNumber String? // Celotna številka računa: PP-EN-ŠT
  operator      String   @default("Blagajnik")
  operatorTaxNo String   @default("SI12345678")
  shiftId       String?
  tip           Float    @default(0) // napitnina (EUR)
  // Flags
  flags         String?  // JSON array: ["vip", "birthday", "rush", "allergy"]
  // Storno
  stornoOf      String?
  stornoReason  String?
  stornoAt      DateTime?
  stornoZoi     String?
  stornoEor     String?
  customerId    String?
  customer      Customer? @relation(fields: [customerId], references: [id])
}

model OrderItem {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
  quantity   Int      @default(1)
  unitPrice  Float // snapshot cene ob naročilu (vključno z modifierji)
  vatRate    Float // snapshot DDV stopnje
  note       String?
  modifiers  String? // JSON array izbranih modifierjev
}

model Reservation {
  id         String   @id @default(cuid())
  restaurantId String
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  tableId    String
  table      Table    @relation(fields: [tableId], references: [id])
  customerName String
  customerPhone String?
  partySize  Int
  date       String // YYYY-MM-DD
  time       String // HH:mm
  duration   Int      @default(120)
  status     String   @default("confirmed")
  note       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ============================================================
// SHIFT & OPERATOR
// ============================================================

model Shift {
  id         String   @id @default(cuid())
  restaurantId String
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  operator   String
  operatorTaxNo String
  startTime  DateTime @default(now())
  endTime    DateTime?
  startCash  Float    @default(0)
  endCash    Float?
  status     String   @default("open")
  ordersCount Int     @default(0)
  totalRevenue Float  @default(0)
  note       String?
  createdAt  DateTime @default(now())
}

model Operator {
  id         String   @id @default(cuid())
  restaurantId String
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name       String
  pin        String
  taxNumber  String   @default("SI12345678")
  role       String   @default("cashier") // "cashier" | "admin"
  hourlyRate Float    @default(12)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  schedules  Schedule[]
  timesheets Timesheet[]

  @@unique([restaurantId, pin])
}

// ============================================================
// INVENTORY
// ============================================================

model InventoryItem {
  id          String   @id @default(cuid())
  restaurantId String
  restaurant  Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name        String
  unit        String   @default("kos")
  quantity    Float    @default(0)
  minQuantity Float    @default(0)
  costPerUnit Float    @default(0)
  supplier    String?
  category    String   @default("splosno")
  expiryDate  DateTime? // rok trajanja (opcijsko)
  batchNumber String?  // številka serije/lote (opcijsko)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  recipes     Recipe[]
  wasteLogs   WasteLog[]
}

model Recipe {
  id              String   @id @default(cuid())
  menuItemId      String
  menuItem        MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  inventoryItemId String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  quantity        Float
  createdAt       DateTime @default(now())
}

// ============================================================
// CRM / LOYALTY
// ============================================================

model Customer {
  id          String   @id @default(cuid())
  restaurantId String
  restaurant  Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name        String
  phone       String?
  email       String?
  points      Int      @default(0)
  totalSpent  Float    @default(0)
  visitCount  Int      @default(0)
  allergens   String?
  note        String?
  birthday    DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  orders      Order[]

  @@unique([restaurantId, phone])
}

// ============================================================
// GIFT CARDS
// ============================================================

model GiftCard {
  id          String   @id @default(cuid())
  restaurantId String
  restaurant  Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  code        String
  balance     Float    @default(0)
  initialAmount Float
  status      String   @default("active")
  customerName String?
  note        String?
  expiresAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([restaurantId, code])
}

// ============================================================
// EMPLOYEE SCHEDULING
// ============================================================

model Schedule {
  id           String   @id @default(cuid())
  operatorId   String
  operator     Operator @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  date         String   // YYYY-MM-DD
  startTime    String   // HH:mm
  endTime      String   // HH:mm
  role         String   @default("waiter")
  note         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([operatorId, date])
}

model Timesheet {
  id           String    @id @default(cuid())
  operatorId   String
  operator     Operator  @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  date         String    // YYYY-MM-DD
  clockIn      DateTime
  clockOut     DateTime?
  breakMinutes Int       @default(0)
  note         String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// ============================================================
// FOOD WASTE TRACKING — sledenje odpadkov
// ============================================================

model WasteLog {
  id              String   @id @default(cuid())
  restaurantId    String
  restaurant      Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  inventoryItemId String?
  inventoryItem   InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)
  menuItemId      String?  // povezava z menijem (če gre za pripravljeno jed)
  name            String   // ime izdelka (snapshot)
  quantity        Float    // količina odpadka
  unit            String   // "kos" | "kg" | "l" | "g" | "ml"
  cost            Float    // strošek odpadka (EUR)
  reason          String   // "expired" | "burnt" | "dropped" | "returned" | "spoilage" | "other"
  note            String?
  operator        String?  // ime operaterja
  createdAt       DateTime @default(now())
}

// ============================================================
// HAPPY HOUR — časovno odvisne cene
// ============================================================

model HappyHour {
  id            String   @id @default(cuid())
  restaurantId  String
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name          String   // "Happy Hour", "Popoldanski popust", itd.
  daysOfWeek    String   // JSON array: [1,2,3,4,5] = pon-pet
  startTime     String   // "16:00"
  endTime       String   // "18:00"
  discountType  String   // "percent" | "fixed"
  discountValue Float    // 30 = 30% off, ali 2 = 2€ off
  // Filter na kategorije (JSON array ali "all")
  categories    String   @default("all") // "all" ali JSON ["alkoholne","brezalkoholne"]
  // Ali velja samo za določene item-e (JSON array itemId-jev ali "all")
  menuItemIds   String   @default("all")
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ============================================================
// COMBO MEALS — set meniji z izbiro pod-itemov
// ============================================================

model ComboMeal {
  id            String   @id @default(cuid())
  restaurantId  String
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name          String   // "Lunch Meni 1", "Biftek meni", itd.
  description   String?
  price         Float    // fiksna cena combo-ja (manjša od vsote posameznih)
  active        Boolean  @default(true)
  // Slike/ikona (opcijsko)
  icon          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  slots         ComboSlot[]
}

// Slot v combo-ju (npr. "Izberi 1 juho", "Izberi 1 glavno jed", "Izberi 1 pijačo")
model ComboSlot {
  id            String   @id @default(cuid())
  comboMealId   String
  comboMeal     ComboMeal @relation(fields: [comboMealId], references: [id], onDelete: Cascade)
  name          String   // "Juha", "Glavna jed", "Pijača"
  required      Boolean  @default(true) // ali mora gost izbrati
  minSelect     Int      @default(1) // min št. izborov
  maxSelect     Int      @default(1) // max št. izborov
  // Povezani MenuItem-i (lahko izbere iz teh)
  itemIds       String   // JSON array menuItemId-jev
  createdAt     DateTime @default(now())
}

// Povratna informacija strank (ocene jedi, service, experience)
model Feedback {
  id            String   @id @default(cuid())
  restaurantId  String
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orderId       String?  // povezava z računom (opcijsko)
  customerId    String?  // povezava s stranko (opcijsko)
  customerName  String?  // ime stranke (če ni prijavljena)
  // Ocene (1-5 zvezdic)
  foodRating    Int      // ocena hrane
  serviceRating Int      // ocena strežbe
  ambienceRating Int?    // ocena ambienta (opcijsko)
  overallRating Int      // skupna ocena
  // Komentar
  comment       String?
  // Kategorije povratnih informacij
  tags          String?  // JSON array: ["fast_service", "delicious", "cold_food", ...]
  // Status
  resolved      Boolean  @default(false) // ali so odgovorili na feedback
  response      String?  // odgovor restavracije
  respondedAt   DateTime?
  // Metadata
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// Čakalna vrsta (waitlist) — gostje ki čakajo na prosto mizo
model WaitlistEntry {
  id            String   @id @default(cuid())
  restaurantId  String
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  customerName  String
  phone         String?
  partySize     Int      @default(2)
  // Status: waiting | seated | left | cancelled
  status        String   @default("waiting")
  // Predviden čas čakanja (min)
  estimatedWait Int?     // v minutah
  // Opomba (alergije, posebne želje)
  note          String?
  // Miza dodeljena ko sede
  tableId       String?
  // SMS/obvestilo poslano
  notified      Boolean  @default(false)
  notifiedAt    DateTime?
  // Timestamps
  seatedAt      DateTime?
  leftAt        DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ============================================================
// SUPPLIER MANAGEMENT — dobavitelji
// ============================================================

model Supplier {
  id            String   @id @default(cuid())
  restaurantId  String
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name          String
  contactPerson String?
  phone         String?
  email         String?
  address       String?
  city          String?
  taxNumber     String?
  paymentTerms  String   @default("30 dni") // plačilni pogoji
  discountPercent Float  @default(0) // rabat %
  note          String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  purchaseOrders PurchaseOrder[]
}

// ============================================================
// CASH DRAWER — gotovinska blagajna (cash in/out, petty cash)
// ============================================================

model CashDrawerEntry {
  id            String   @id @default(cuid())
  restaurantId  String
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  type          String   // "cash_in" | "cash_out" | "sale" | "refund" | "petty" | "start" | "end"
  amount        Float    // vedno pozitivno; direction določa tok
  direction     String   // "in" | "out"
  reason        String?
  operator      String?
  shiftId       String?
  balanceBefore Float    @default(0)
  balanceAfter  Float    @default(0)
  createdAt     DateTime @default(now())
}

// ============================================================
// PURCHASE ORDERS — nabavni nalogi
// ============================================================

model PurchaseOrder {
  id            String   @id @default(cuid())
  restaurantId  String
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  supplierId    String?
  supplier      Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  poNumber      String   // "PO-2026-001" — unikaten znotraj restavracije
  status        String   @default("draft") // "draft" | "sent" | "received" | "cancelled"
  orderDate     DateTime @default(now())
  expectedDate  DateTime?
  receivedDate  DateTime?
  totalAmount   Float    @default(0) // vsota postavk (po rabatu)
  discountPercent Float  @default(0)
  note          String?
  operator      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  items         PurchaseOrderItem[]

  @@unique([restaurantId, poNumber])
}

model PurchaseOrderItem {
  id              String   @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  inventoryItemId String?
  name            String   // ime izdelka (snapshot)
  quantity        Float    // naročena količina
  receivedQty     Float    @default(0) // prejeta količina
  unit            String   @default("kos")
  unitCost        Float    // cena na enoto (EUR)
  lineTotal       Float    // quantity * unitCost
  createdAt       DateTime @default(now())
}

// ============================================================
// EQUIPMENT — oprema in vzdrževanje
// ============================================================

model Equipment {
  id            String   @id @default(cuid())
  restaurantId  String
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name          String   // "Hladilnik Bosch", "Pečica Gorenje"
  category      String   // "cooling" | "cooking" | "dishwashing" | "preparation" | "other"
  serialNumber  String?
  manufacturer  String?
  model         String?
  location      String?  // "Kuhinja", "Hladilnica", "Bar"
  purchaseDate  DateTime?
  purchaseCost  Float    @default(0)
  warrantyExpiry DateTime?
  // Vzdrževanje
  lastServiceDate DateTime?
  nextServiceDate DateTime?
  serviceIntervalDays Int @default(90) // interval vzdrževanja v dnevih
  status        String   @default("operational") // "operational" | "maintenance" | "broken" | "retired"
  note          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  maintenanceLogs EquipmentMaintenance[]
}

model EquipmentMaintenance {
  id            String   @id @default(cuid())
  equipmentId   String
  equipment     Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  type          String   // "routine" | "repair" | "inspection" | "cleaning" | "replacement"
  description   String
  cost          Float    @default(0)
  technician    String?  // kdo je opravil
  serviceDate   DateTime @default(now())
  nextServiceDate DateTime? // naslednji predvideni servis
  status        String   @default("completed") // "scheduled" | "in_progress" | "completed" | "cancelled"
  note          String?
  createdAt     DateTime @default(now())
}

// ============================================================
// STOCK TRANSFER — medlokalni prenosi zalog
// ============================================================

model StockTransfer {
  id              String   @id @default(cuid())
  restaurantId    String   // izvorna restavracija (tenant)
  restaurant      Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  toRestaurantId  String   // ciljna restavracija
  toRestaurantName String  // snapshot imena cilja
  transferNumber  String   // "ST-2026-001"
  status          String   @default("draft") // "draft" | "sent" | "received" | "cancelled"
  transferDate    DateTime @default(now())
  receivedDate    DateTime?
  totalItems      Int      @default(0)
  totalValue      Float    @default(0)
  note            String?
  operator        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  items           StockTransferItem[]

  @@unique([restaurantId, transferNumber])
}

model StockTransferItem {
  id              String   @id @default(cuid())
  stockTransferId String
  stockTransfer   StockTransfer @relation(fields: [stockTransferId], references: [id], onDelete: Cascade)
  inventoryItemId String?
  name            String   // snapshot imena
  quantity        Float    // količina za prenos
  unit            String   @default("kos")
  unitCost        Float    @default(0)
  lineTotal       Float    @default(0)
  createdAt       DateTime @default(now())
}

