// Prisma schema za slovensko restavracijsko blagajno (POS)
// Navdihnjeno po ICEPOS arhitekturi, prilagojeno za slovenski trg (EUR, DDV)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model MenuItem {
  id        String   @id @default(cuid())
  name      String
  category  String // "predjedi" | "glavne_jedi" | "brezalkoholne" | "alkoholne" | "sladice"
  price     Float // EUR
  vatRate   Float // 0.095 (znižana - hrana) | 0.22 (splošna - alkohol)
  available Boolean  @default(true)
  desc      String?
  createdAt DateTime @default(now())
  orderItems OrderItem[]
  modifiers Modifier[]
  recipes    Recipe[]
}

model Modifier {
  id         String   @id @default(cuid())
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  label      String // npr. "Brez čebule", "Dobra pečena", "Bez glutena"
  priceDelta Float    @default(0) // sprememba cene ( Lahko negativna za popust)
  createdAt  DateTime @default(now())
}

model Table {
  id        String   @id @default(cuid())
  number    Int      @unique
  name      String
  seats     Int      @default(4)
  section   String   @default("Dvorana") // "Dvorana" | "Terasa" | "Zasebna"
  createdAt DateTime @default(now())
  orders    Order[]
  reservations Reservation[]
}

model Order {
  id            String    @id @default(cuid())
  tableId       String
  table         Table     @relation(fields: [tableId], references: [id])
  status        String    @default("open") // "open" | "paid" | "cancelled" | "storno"
  items         OrderItem[]
  total         Float     @default(0)
  vatTotal      Float     @default(0)
  createdAt     DateTime  @default(now())
  paidAt        DateTime?
  paymentMethod String? // "cash" | "card"
  receiptNo     String? // SRS številka računa (npr. 1, 2, 3 ...)
  zoi           String? // Zaščitna oznaka izdajatelja (ZOI) — 32 hex znakov
  eor           String? // Enkratna identifikacija računa (EOR) — UUID
  fursXml       String? // Podpisan XML računa za FURS (audit)
  businessUnit  String   @default("PREVOZ11") // Oznaka poslovnega prostora
  cashRegister  String   @default("BLAG01") // Oznaka elektronske naprave
  invoiceNumber String? // Celotna številka računa: PP-EN-ŠT
  operator      String   @default("Blagajnik")
  operatorTaxNo String   @default("SI12345678") // Davčna št. blagajnika
  shiftId       String? // povezava s Smeno (FURS zahteva sledljivost)
  tip           Float    @default(0) // napitnina (EUR)
  // Storno
  stornoOf      String? // ID izvirnega računa, če je to storno
  stornoReason  String?
  stornoAt      DateTime?
  stornoZoi     String?
  stornoEor     String?
  customerId    String?
  customer      Customer? @relation(fields: [customerId], references: [id])
}

model OrderItem {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
  quantity   Int      @default(1)
  unitPrice  Float // snapshot cene ob naročilu (vključno z modifierji)
  vatRate    Float // snapshot DDV stopnje
  note       String? // prosto besedilo (npr. "brez čebule")
  modifiers  String? // JSON array izbranih modifierjev (label + priceDelta)
}

model Reservation {
  id         String   @id @default(cuid())
  tableId    String
  table      Table    @relation(fields: [tableId], references: [id])
  customerName String
  customerPhone String?
  partySize  Int // število oseb
  date       String // YYYY-MM-DD
  time       String // HH:mm
  duration   Int      @default(120) // minute
  status     String   @default("confirmed") // "confirmed" | "seated" | "cancelled" | "no_show"
  note       String? // alergije, priložnosti (rojstni dan), posebne zahteve
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Shift {
  id         String   @id @default(cuid())
  operator   String // ime blagajnika
  operatorTaxNo String
  startTime  DateTime @default(now())
  endTime    DateTime?
  startCash  Float    @default(0) // gotovina na začetku smene
  endCash    Float? // gotovina na koncu smene
  status     String   @default("open") // "open" | "closed"
  ordersCount Int     @default(0)
  totalRevenue Float  @default(0)
  note       String? // opomba ob zaključku
  createdAt  DateTime @default(now())
}

model Operator {
  id         String   @id @default(cuid())
  name       String
  pin        String   @unique // 4-mesten PIN
  taxNumber  String   @default("SI12345678")
  role       String   @default("cashier") // "cashier" | "admin"
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
}

// === INVENTORY MANAGEMENT ===

model InventoryItem {
  id          String   @id @default(cuid())
  name        String
  unit        String   @default("kos") // "kos" | "kg" | "l" | "g" | "ml"
  quantity    Float    @default(0)
  minQuantity Float    @default(0) // alert ko pade pod
  costPerUnit Float    @default(0) // nabavna cena na enoto
  supplier    String?
  category    String   @default("splosno") // "meso" | "zelenjava" | "pijaca" | "splosno"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  recipes     Recipe[]
}

model Recipe {
  id              String   @id @default(cuid())
  menuItemId      String
  menuItem        MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  inventoryItemId String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  quantity        Float // kolicina potrebna za 1 porcijo
  createdAt       DateTime @default(now())
}

// === CRM / LOYALTY ===

model Customer {
  id          String   @id @default(cuid())
  name        String
  phone       String?  @unique
  email       String?
  points      Int      @default(0) // tocke zvestobe
  totalSpent  Float    @default(0) // skupna poraba
  visitCount  Int      @default(0) // stevilo obiskov
  allergens   String?  // JSON array alergij stranke
  note        String?  // opombe (alergije, preference)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  orders      Order[]
}

// === GIFT CARDS ===

model GiftCard {
  id          String   @id @default(cuid())
  code        String   @unique // 8-mestna koda (npr. GC-AB12CD34)
  balance     Float    @default(0) // trenutno stanje
  initialAmount Float  // začetni znesek
  status      String   @default("active") // "active" | "used" | "expired"
  customerName String? // ime prejemnika (opcijsko)
  note        String?
  expiresAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
