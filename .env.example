# ============================================================
# Gostilna POS — okoljske spremenljivke (primer)
# ============================================================
# Kopiraj v .env in prilagodi:  cp .env.example .env
# ============================================================

# --- BAZA PODATKOV ---
# SQLite (privzeto, priporočeno za demo/manjše restavracije)
DATABASE_URL="file:/home/z/my-project/db/custom.db"
# Za produkcijo s PostgreSQL:
# DATABASE_URL="postgresql://user:pass@localhost:5432/gostilna_pos?schema=public"

# --- APLIKACIJA ---
# Naslednji port (Next.js privzeto 3000)
PORT=3000
# Production URL (za CORS, QR kode, itd.)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- KITCHEN WEBSOCKET SERVICE ---
# Port za mini-services/kitchen-service (socket.io)
KITCHEN_SERVICE_PORT=3003
NEXT_PUBLIC_KITCHEN_WS_URL="/?XTransformPort=3003"

# --- AVTENTIKACIJA (NextAuth) ---
NEXTAUTH_SECRET="spremeni-me-v-produkciji-z-dolgo-nakljucno-vrednostjo"
NEXTAUTH_URL="http://localhost:3000"

# --- FURS (Fiskalizacija) ---
# Davcna stevilka restavracije (z ali brez predpone "SI")
FURS_TAX_NUMBER="12345678"
# Oznaka poslovnega prostora (registrirano pri FURS)
FURS_BUSINESS_UNIT="PREVOZ11"
# Oznaka elektronske naprave (blagajna)
FURS_CASH_REGISTER="BLAG01"
# Pot do digitalnega potrdila eDavki (produkcija)
FURS_CERT_PATH=""
# Geslo digitalnega potnega lista
FURS_CERT_PASSWORD=""
# FURS okolje: "test" | "production"
FURS_ENV="test"
# FURS REST API endpointi (test):
#   https://blagajne-test.fu.gov.si:9002/v1/cash_registers/
# Produkcija:
#   https://blagajne.fu.gov.si:9002/v1/cash_registers/

# --- OPERATORJI (default, za demo) ---
# Te se nastavijo preko UI (Settings → Operaterji)
# Demo: 1234 (admin), 5678 (cashier), 9999 (cashier)

# --- LOYALTY ---
# Koliko EUR na tocko zvestobe (privzeto 1 tocka na 10 EUR)
LOYALTY_POINTS_PER_EUR="0.1"

# --- GIFT CARDS ---
# Dolzina kode darilne kartice (privzeto 8 znakov brez predpone GC-)
GIFT_CARD_CODE_LENGTH="8"

# --- Z-REPORT ---
# Path za shranjevanje dnevncih porocil (opcija)
Z_REPORT_PATH=""

# === Super-admin (Task R1) ===
SUPER_ADMIN_KEY=spremeni-me-v-produkciji

# === Stripe (Task R4) ===
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# === Wolt ===
WOLT_CLIENT_ID=
WOLT_CLIENT_SECRET=
WOLT_WEBHOOK_SECRET=
WOLT_API_BASE=https://pos-integration.wolt.com/v1

# === Deliverect ===
DELIVERECT_CLIENT_ID=
DELIVERECT_CLIENT_SECRET=
DELIVERECT_WEBHOOK_SECRET=
DELIVERECT_API_BASE=https://api.deliverect.com

# === OpenTable / Resy ===
OPENTABLE_API_KEY=
OPENTABLE_WEBHOOK_SECRET=
RESY_API_KEY=
RESY_WEBHOOK_SECRET=

# === Sumup ===
SUMUP_API_KEY=
SUMUP_MERCHANT_CODE=
SUMUP_API_BASE_EU=https://api.sumup.com

# === ZAI SDK ===
ZAI_API_KEY=

# === FURS private key (base64 PEM) ===
FURS_PRIVATE_KEY=
