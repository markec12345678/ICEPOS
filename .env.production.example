# ============================================================
# Gostilna POS - Production Environment Variables
# ============================================================
# Kopiraj v .env.production in spremeni vrednosti!
#   cp .env.production.example .env.production
# ============================================================

# --- Database (PostgreSQL) ---
POSTGRES_USER=icepos
POSTGRES_PASSWORD=GENERIRAJ-MOCNO-GESLO
POSTGRES_DB=icepos

# --- NextAuth ---
# Generiraj: openssl rand -base64 32
NEXTAUTH_SECRET=GENERIRAJ-NAKLJUCNO
NEXTAUTH_URL=https://pos.tvoja-domena.si

# --- Super-admin (za POST /api/restaurants) ---
# Generiraj: openssl rand -base64 32
SUPER_ADMIN_KEY=GENERIRAJ-NAKLJUCNO

# --- FURS (Slovenija) ---
FURS_ENV=production
FURS_TAX_NUMBER=12345678
FURS_BUSINESS_UNIT=PREVOZ11
FURS_CASH_REGISTER=BLAG01
FURS_CERT_PATH=/etc/icepos/certs
FURS_CERT_PASSWORD=geslo-za-p12
FURS_PRIVATE_KEY=base64-pem-kljuc

# --- Stripe ---
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_PUBLISHABLE_KEY=pk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# --- Sentry (error tracking, optional) ---
SENTRY_DSN=

# --- Sumup ---
SUMUP_API_KEY=
SUMUP_MERCHANT_CODE=

# --- Wolt ---
WOLT_CLIENT_ID=
WOLT_CLIENT_SECRET=
WOLT_WEBHOOK_SECRET=

# --- Deliverect ---
DELIVERECT_CLIENT_ID=
DELIVERECT_CLIENT_SECRET=
DELIVERECT_WEBHOOK_SECRET=

# --- OpenTable ---
OPENTABLE_API_KEY=
OPENTABLE_WEBHOOK_SECRET=

# --- ZAI SDK (AI slike) ---
ZAI_API_KEY=
